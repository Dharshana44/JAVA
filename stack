import java.util.Scanner;
// Stack class definition
class Stack {
 private int maxSize = 10; // Maximum size of the stack
 private int[] stackArray; // Array to hold stack elements
 private int top; // Index of the top element
 // Constructor to initialize the stack
 public Stack() {
 stackArray = new int[maxSize]; // Initialize the stack array
 top = -1; // Stack is initially empty
 }
 // Method to push an element onto the stack
 public void push(int value) {
 if (top == maxSize - 1) {
 System.out.println("Stack is full. Unable to push " + value);
 } else {
 stackArray[++top] = value; // Increment top and add value
 System.out.println("Pushed: " + value);
 }
 }
 // Method to pop an element from the stack
 public int pop() {
 if (top == -1) {
 System.out.println("Stack is empty. Unable to pop.");
 return -1; // Indicating that the stack is empty
 } else {
 return stackArray[top--]; // Return top value and decrement top
 }
 }
 // Method to display the elements in the stack
 public void display() {
 if (top == -1) {
 System.out.println("Stack is empty.");
 } else {
 System.out.print("Stack elements: ");
 for (int i = 0; i <= top; i++) {
 System.out.print(stackArray[i] + " ");
 }
 System.out.println();
 }
 }
}
// Main class to demonstrate stack operations
public class StackDemo {
 public static void main(String[] args) {
 Scanner scanner = new Scanner(System.in);
 Stack stack = new Stack(); // Create an instance of Stack
 // Menu-driven input for stack operations
 while (true) {
 System.out.println("\nStack Operations:");
 System.out.println("1. Push");
 System.out.println("2. Pop");
 System.out.println("3. Display");
 System.out.println("4. Exit");
 System.out.print("Choose an operation: ");
 int choice = scanner.nextInt();
 switch (choice) {
 case 1: // Push operation
 System.out.print("Enter a value to push: ");
 int value = scanner.nextInt();
 stack.push(value);
 break;
 case 2: // Pop operation
 int poppedValue = stack.pop();
 if (poppedValue != -1) {
 System.out.println("Popped: " + poppedValue);
 }
 break;
 case 3: // Display stack
 stack.display();
 break;
 case 4: // Exit
 System.out.println("Exiting...");
 scanner.close();
 return; // Exit the program
 default:
 System.out.println("Invalid choice. Please try again.");
 }
 }
 }
}
